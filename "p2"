import { Database } from "bun:sqlite";
const db = new Database(process.argv[2]);
const u = (db.query("SELECT id FROM users LIMIT 1").get() as { id: string }).id;
const t = (d: number, h = 10) => new Date(Date.UTC(2026, 9, d, h)).toISOString();
const run = (sql: string, ...p: unknown[]) => db.prepare(sql).run(...(p as never[]));
for (const [id, name] of [["p1", "NarraFork 后端"], ["p2", "移动端 App"]])
  run(`INSERT INTO projects (id,name,git_path,visibility,owner_user_id,created_at,updated_at) VALUES (?,?,?,'public',?,?,?)`, id, name, `/tmp/${id}`, u, t(1), t(1));
const nar = (id: string, c: string, title: string, last: string, extra: { type?: string; parent?: string; sub?: string; status?: string } = {}) =>
  run(`INSERT INTO narrators (id,context_project_id,title,type,subagent_type,parent_narrator_id,acl_root_narrator_id,status,visibility,owner_user_id,last_message_at,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,'public',?,?,?,?)`,
    id, c, title, extra.type ?? "primary", extra.sub ?? null, extra.parent ?? null, extra.parent ?? null, extra.status ?? "idle", u, last, t(3), last);
let i = 0;
const msg = (n: string, role: string, text: string, at: string, origin: string | null = null) =>
  run(`INSERT INTO narrator_messages (id,narrator_id,role,origin,content_json,content_text,created_at) VALUES (?,?,?,?,'[]',?,?)`, `m${++i}`, n, role, origin, text, at);
nar("n1", "p1", "修复 refresh token 过早过期", t(21, 16));
msg("n1", "user", "登录后 refresh token 很快就过期了，帮我查一下原因", t(21, 9));
msg("n1", "assistant", "refresh token 的 TTL 读的是 access token 的配置项，我来修正", t(21, 10));
msg("n1", "assistant", "已更新 refresh token 轮换逻辑，并补了单元测试", t(21, 11));
msg("n1", "user", "顺便把 refresh token 的 cookie 设成 httpOnly", t(21, 14));
msg("n1", "assistant", "refresh token cookie 已改为 httpOnly + SameSite=Lax", t(21, 15));
msg("n1", "assistant", "回归测试通过：refresh token 在 30 天内保持有效", t(21, 16));
msg("n1", "sys", "知识库提示：认证手册 — refresh token 轮换策略", t(21, 9), "system");
nar("s1", "p1", "explore: 查找 refresh 调用方", t(21, 10), { type: "subagent", parent: "n1", sub: "explore" });
msg("s1", "assistant", "共找到 12 处调用 refresh token helper", t(21, 10));
nar("n2", "p1", "限流器设计", t(18));
msg("n2", "assistant", "限流不能拦截 refresh token 请求，否则会话会被意外登出", t(18));
nar("n3", "p2", "登录页 refresh token 静默续期", t(5));
msg("n3", "user", "登录页需要在后台静默续期 refresh token", t(5));
nar("n4", "p1", "旧的 token 方案讨论", t(1), { status: "archived" });
msg("n4", "assistant", "旧方案里 refresh token 存在 localStorage", t(1));
