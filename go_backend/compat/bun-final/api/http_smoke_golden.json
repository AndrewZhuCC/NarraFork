{
	"artifactVersion": 1,
	"source": "bun-final-frontend-contract-seed",
	"normalization": {
		"volatileFields": [
			"token",
			"createdAt",
			"updatedAt",
			"lastAccessedAt",
			"timestamp",
			"path",
			"port"
		],
		"comparisonMode": "shape-plus-stable-values"
	},
	"cases": [
		{
			"id": "health-public",
			"method": "GET",
			"path": "/api/health",
			"auth": "none",
			"expectedStatus": 200,
			"requiredTopLevelKeys": ["status", "version", "platform", "gitAvailable", "capabilities"]
		},
		{
			"id": "auth-status-public",
			"method": "GET",
			"path": "/api/auth/status",
			"auth": "optional",
			"expectedStatus": 200,
			"requiredTopLevelKeys": ["authenticated", "registrationOpen"]
		},
		{
			"id": "projects-list-authenticated",
			"method": "GET",
			"path": "/api/projects",
			"auth": "required",
			"expectedStatus": 200,
			"requiredTopLevelKeys": ["projects"]
		},
		{
			"id": "settings-get-authenticated",
			"method": "GET",
			"path": "/api/settings",
			"auth": "required",
			"expectedStatus": 200,
			"requiredTopLevelKeys": ["settings"]
		},
		{
			"id": "search-empty-query-authenticated",
			"method": "GET",
			"path": "/api/search?q=",
			"auth": "required",
			"expectedStatus": 200,
			"requiredTopLevelKeys": ["results", "metadata"]
		},
		{
			"id": "update-check-authenticated",
			"method": "GET",
			"path": "/api/update/check",
			"auth": "required",
			"expectedStatus": 200,
			"requiredTopLevelKeys": ["currentVersion", "updateAvailable"]
		}
	]
}
